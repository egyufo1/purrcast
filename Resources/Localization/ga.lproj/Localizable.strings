/* Aistriúchán Gaeilge. Keys are the English texts; check: Resources/Localization/check.sh */

/* Errors */
"timed out" = "imithe thar am";
"Not found: %@. Install it with: brew install ffmpeg" = "Ní bhfuarthas: %@. Suiteáil é le: brew install ffmpeg";
