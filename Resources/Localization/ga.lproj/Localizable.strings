"The file has no video track." = "Níl rian físe sa chomhad.";
"ffmpeg stopped with an error:\n%@" = "Stop ffmpeg le hearráid:\n%@";
"Not enough free space for the temporary stream files (needs about %@, free: %@)." = "Níl go leor spáis saor ann do na comhaid sruthaithe shealadacha (tá thart ar %@ ag teastáil, saor: %@).";
