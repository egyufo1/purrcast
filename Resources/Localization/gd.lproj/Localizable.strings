/* Eadar-theangachadh Gàidhlig. Keys are the English texts; check: Resources/Localization/check.sh */

/* Errors */
"timed out" = "dh’fhalbh an ùine";
"Not found: %@. Install it with: brew install ffmpeg" = "Cha deach a lorg: %@. Stàlaich e le: brew install ffmpeg";
"Couldn't read the file: %@" = "Cha b’ urrainn dhuinn am faidhle a leughadh: %@";
"The file has no video track." = "Chan eil traca video san fhaidhle.";
"ffmpeg stopped with an error:\n%@" = "Stad ffmpeg le mearachd:\n%@";
"Not enough free space for the temporary stream files (needs about %@, free: %@)." = "Chan eil àite saor gu leòr ann airson nam faidhlichean sruthaidh sealach (feumar mu %@, saor: %@).";
"The local stream server didn't start: %@" = "Cha do thòisich am frithealaiche sruthaidh ionadail: %@";
"Didn't start with the previous settings, retrying in a safer mode…" = "Cha do thòisich e leis na roghainnean roimhe, a’ feuchainn a-rithist ann am modh nas sàbhailte…";
"Couldn't start playback:\n%@\n\nDetails: ~/Library/Logs/Purrcast.log" = "Cha b’ urrainn dhuinn a’ chluich a thòiseachadh:\n%@\n\nMion-fhiosrachadh: ~/Library/Logs/Purrcast.log";
"player error: %@" = "mearachd a’ chluicheadair: %@";
"playback didn't start within 20 seconds" = "cha do thòisich a’ chluich taobh a-staigh 20 diog";
"Error" = "Mearachd";

