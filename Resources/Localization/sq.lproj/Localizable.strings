/* Albanian translation. Keys are the English texts; check: Resources/Localization/check.sh */

/* Errors */
"timed out" = "koha mbaroi";
"Not found: %@. Install it with: brew install ffmpeg" = "Nuk u gjet: %@. Instaloje me: brew install ffmpeg";
"Couldn't read the file: %@" = "Skedari nuk u lexua dot: %@";
"The file has no video track." = "Skedari nuk ka pistë video.";
"ffmpeg stopped with an error:\n%@" = "ffmpeg u ndal me një gabim:\n%@";
"Not enough free space for the temporary stream files (needs about %@, free: %@)." = "Nuk ka hapësirë të mjaftueshme për skedarët e përkohshëm të transmetimit (duhen rreth %@, e lirë: %@).";
"The local stream server didn't start: %@" = "Shërbyesi lokal i transmetimit nuk u nis: %@";
"Didn't start with the previous settings, retrying in a safer mode…" = "Nuk u nis me rregullimet e mëparshme, po riprovohet në një mënyrë më të sigurt…";
"Couldn't start playback:\n%@\n\nDetails: ~/Library/Logs/Purrcast.log" = "Luajtja nuk u nis dot:\n%@\n\nHollësi: ~/Library/Logs/Purrcast.log";
"player error: %@" = "gabim i luajtësit: %@";
"playback didn't start within 20 seconds" = "luajtja nuk nisi brenda 20 sekondash";
"Error" = "Gabim";

